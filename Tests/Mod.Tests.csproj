             Link="ContextualSettings\ContextualSettingsRouterCore.cs" />
    <Compile Include="..\Source\Spine\UI\SettingsFramework\SettingsPresentationPolicy.cs"
             Link="SettingsFramework\SettingsPresentationPolicy.cs" />
    <Compile Include="..\Source\Spine\UI\SettingsFramework\SettingType.cs"
             Link="SettingsFramework\SettingType.cs" />
    <Compile Include="..\Source\Spine\UI\SettingsFramework\SettingDefinition.cs"
             Link="SettingsFramework\SettingDefinition.cs" />
    <Compile Include="..\Source\Spine\UI\SettingsFramework\SettingDefinitions.cs"
             Link="SettingsFramework\SettingDefinitions.cs" />
