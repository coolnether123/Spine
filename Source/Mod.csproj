<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RwtIsRimWorldMod>true</RwtIsRimWorldMod>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>Spine</AssemblyName>
    <RootNamespace>Spine</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputPath>..\1.6\Assemblies\</OutputPath>
    <RwtUseHarmony>true</RwtUseHarmony>
    <RwtUseUnityImGui>true</RwtUseUnityImGui>
    <RwtUseUnityInputLegacy>true</RwtUseUnityInputLegacy>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Spine\harmony\HarmonyCompat.cs" />
    <Compile Remove="Spine\harmony\Transpilers\**\*.cs" />
  </ItemGroup>
</Project>
